__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/

# Agent-harness operational state. Per-machine, per-session scratch that hooks
# rewrite on every tool call, so a tracked one dirties the working tree constantly
# and can block a branch switch (it did: it blocked the checkout for this merge).
# Contents are excluded rather than the directory itself, so a deliberate exception
# can still be re-included -- .omc/skills/ is the documented committable one.
**/.omc/*
!**/.omc/skills/
**/.omx/*
**/.claude/*
**/.superpowers/*

build/
dist/
artifacts/
data/banking-v3-tool-sft/
data/banking-router-v1/
data/banking-conversation-router-v4/
data/banking-servicing-alignment-v4/
*.egg-info/
