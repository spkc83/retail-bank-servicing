__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/

# Agent-harness operational state. Per-machine, per-session scratch that hooks
# rewrite on every tool call, so a tracked one dirties the working tree constantly
# and can block a branch switch (it did: it blocked the checkout for this merge).
# Contents are excluded rather than the directory itself, so a deliberate exception
# can still be re-included -- .omc/skills/ is the documented committable one.
**/.omc/*
!**/.omc/skills/
**/.omx/*
**/.claude/*
**/.superpowers/*

build/
dist/
artifacts/
data/banking-v3-tool-sft/
data/banking-router-v1/
data/banking-conversation-router-v4/
data/banking-servicing-alignment-v4/
*.egg-info/

# Router experiment outputs. These are candidate corpora from sweeps, not
# releases: twelve of them sat untracked in the working tree, one `git add -A`
# away from a public repo. Ignored rather than deleted -- `git add -f` still
# commits one deliberately, which is how a candidate should be promoted.
data/banking-conversation-router-*-candidate*/
data/banking-conversation-router-v9-clean/
data/banking-conversation-router-v9-unsupported-capability/
data/sources/banking-conversation-router-*-candidate*.lock.json
data/sources/banking-conversation-router-v9-clean.lock.json
data/sources/banking-conversation-router-v9-unsupported-capability.lock.json
sweep_*.jsonl
